#ifndef EnsembleDevice_h
#define EnsembleDevice_h

#include <DriverKit/IOInterruptDispatchSource.iig>
#include <PCIDriverKit/IOPCIDevice.iig>
#include <AudioDriverKit/IOUserAudioDevice.iig>

#include "Protocol.h"

using namespace AudioDriverKit;

class EnsemblePsoc;

class EnsembleDevice: public IOUserAudioDevice
{
public:
    virtual bool init(IOUserAudioDriver * in_driver,
                      bool in_supports_prewarming,
                      OSString * in_device_uid,
                      OSString * in_model_uid,
                      OSString * in_manufacturer_uid,
                      uint32_t in_zero_timestamp_period) override LOCALONLY;
    virtual void free() override LOCALONLY;

    kern_return_t Attach(IOPCIDevice * pci, uint8_t bar0) LOCALONLY;
    void Detach() LOCALONLY;
    void Sleep() LOCALONLY;
    void Wake() LOCALONLY;
    void VolumeChanged(float decibels) LOCALONLY;
    void ClockSourceChanged(uint64_t source) LOCALONLY;
    void Reported(const Ensemble::Report & report) LOCALONLY;
    EnsemblePsoc * Psoc() LOCALONLY;
    IOMemoryDescriptor * Meters() LOCALONLY;

    virtual kern_return_t StartIO(IOUserAudioStartStopFlags in_flags) final LOCALONLY;
    virtual kern_return_t StopIO(IOUserAudioStartStopFlags in_flags) final LOCALONLY;
    virtual kern_return_t HandleChangeSampleRate(double in_sample_rate) final LOCALONLY;
    virtual kern_return_t PerformDeviceConfigurationChange(uint64_t change_action,
                                                           OSObject * in_change_info) final LOCALONLY;

private:
    kern_return_t applyRate(double rate) LOCALONLY;
    void setLatency(double rate) LOCALONLY;
    kern_return_t allocateMeters() LOCALONLY;
    kern_return_t program() LOCALONLY;
    void halt() LOCALONLY;
    void startAudio(uint64_t sample_time) LOCALONLY;
    kern_return_t addVolume() LOCALONLY;
    kern_return_t addClockSource() LOCALONLY;
    void nameChannels(IOUserAudioObjectPropertyScope scope, bool input, uint32_t count) LOCALONLY;
    virtual void WrapOccurred(OSAction * action, uint64_t count, uint64_t time)
        TYPE(IOInterruptDispatchSource::InterruptOccurred);
};

#endif
